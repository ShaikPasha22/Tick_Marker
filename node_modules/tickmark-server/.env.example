# Server Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/tickmark

# JWT secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# Email (Nodemailer via Gmail — for password reset)
# Enable "Less secure apps" or use an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=TickMark <your_email@gmail.com>

# Password reset token expiry (minutes)
RESET_TOKEN_EXPIRY_MINS=60

# Voice Assistant (Generative AI)
GEMINI_API_KEY=your_gemini_api_key_here
